APP_NAME="Muslim Abaya API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
