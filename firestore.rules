rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read products, but only authenticated or authorized requests to write.
    // For simplicity of an app without email authentication, we'll allow public reads, and we use local check or simple validation.
    match /products/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    // Allow anyone to create an order, and read/write for order management.
    match /orders/{document} {
      allow read, write: if true;
    }
  }
}
