  Cache-Control: public, max-age=31536000, immutable

# Admin panel CSS/JS changes constantly during active work. The blanket rules above mark
# every .css/.js file "immutable" for a year, so a browser that already loaded an admin
# stylesheet once will never even ask the server for a newer one until this is cleared.
# These admin-only files instead revalidate on every load: Cloudflare Pages gives each file
# a content ETag, so an unchanged file still answers with a near-instant 304.
/admin*.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/admin*.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/product-manager*.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/product-manager*.js
  ! Cache-Control
