{
  "id": null,
  "uid": "luxury-dress-bd-probes",
  "title": "Luxury Dress BD — Synthetic Probes",
  "tags": ["ecommerce", "synthetic-probe", "luxury-dress-bd"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Probe status (1 = healthy)",
      "description": "GET-only Blackbox Exporter probes. Apps Script order writes are not tested here.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "probe_success{job=\"storefront-probes\"}", "legendFormat": "{{probe_class}} · {{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name"
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP response status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "probe_http_status_code{job=\"storefront-probes\"}", "legendFormat": "{{probe_class}} · {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Synthetic probe duration",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "probe_duration_seconds{job=\"storefront-probes\"}", "legendFormat": "{{probe_class}} · {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Storefront TLS certificate — days remaining",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "(probe_ssl_earliest_cert_expiry{job=\"storefront-probes\", probe_class=\"storefront\"} - time()) / 86400", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 14 }, { "color": "green", "value": 30 }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto"
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 15 }
    }
  ],
  "annotations": { "list": [] },
  "links": []
}
