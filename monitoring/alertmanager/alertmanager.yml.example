# Practical template. Copy to alertmanager.yml and replace example recipients/hostnames.
# Never put webhook URLs, SMTP passwords, or tokens in this repository.
global:
  resolve_timeout: 5m
  smtp_smarthost: smtp.example.com:587
  smtp_from: ecommerce-alerts@example.invalid
  smtp_auth_username: ecommerce-alerts@example.invalid
  smtp_auth_password_file: /run/secrets/alertmanager_smtp_password
  smtp_require_tls: true

route:
  receiver: email-operations
  group_by: [alertname, service, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # P1: notify the on-call Slack channel and also send the email copy below.
    - matchers:
        - severity="critical"
      receiver: slack-p1
      repeat_interval: 15m
      continue: true
    - matchers:
        - severity=~"critical|warning"
      receiver: email-operations

receivers:
  - name: slack-p1
    slack_configs:
      - api_url_file: /run/secrets/alertmanager_slack_webhook_url
        channel: "#ecommerce-alerts"
        username: Alertmanager
        send_resolved: true
        title: '[{{ .Status }}] {{ .CommonAnnotations.summary }}'
        text: >-
          *Severity:* {{ .CommonLabels.severity }}
          *Service:* {{ .CommonLabels.service }}
          *Target:* {{ .CommonLabels.instance }}
          *Details:* {{ .CommonAnnotations.description }}

  - name: email-operations
    email_configs:
      - to: oncall@example.invalid
        send_resolved: true
        headers:
          subject: '[{{ .Status }}][{{ .CommonLabels.severity }}] {{ .CommonAnnotations.summary }}'
        text: >-
          Severity: {{ .CommonLabels.severity }}
          Service: {{ .CommonLabels.service }}
          Target: {{ .CommonLabels.instance }}
          Details: {{ .CommonAnnotations.description }}

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [service]
