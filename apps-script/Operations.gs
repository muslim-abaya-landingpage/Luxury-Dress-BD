 for(var i=0;i<rows.length&&sent<10;i++){
  var r=rows[i],status=String(r[5]||'');
  if(String(r[0])!==id||!String(r[6]||'').trim()||opsNorm_(r[6])!==opsNorm_(variant)||status&&status!=='email_failed')continue;
  if(String(r[3])!=='yes'){sh.getRange(i+2,6).setValue('pending-whatsapp');continue;}
  try{MailApp.sendEmail({to:String(r[2]),subject:'আপনার নির্বাচিত সাইজ আবার স্টকে — Muslim Abaya',body:'আসসালামু আলাইকুম,\n\n'+r[1]+' — '+r[6]+' আবার স্টকে এসেছে। মজুত পরিবর্তিত হতে পারে; অর্ডারের সময় বর্তমান স্টক যাচাই হবে।\n\nhttps://muslimabaya.com/product/'+encodeURIComponent(id)+'\n\nএই নির্দিষ্ট পণ্য/সাইজের জন্য আপনার অনুরোধ অনুযায়ী জানানো হলো।'});sh.getRange(i+2,6).setValue('emailed:'+new Date().toISOString());sent++;}
  catch(err){sh.getRange(i+2,6).setValue('email_failed');}
 }
}
