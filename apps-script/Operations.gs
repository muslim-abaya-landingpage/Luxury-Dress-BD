function opsAmount_(v){if(v===null||v===undefined||String(v).trim()==='')return null;var n=Number(v);if(!isFinite(n)||n<0||n>100000000||Math.abs(n*100-Math.round(n*100))>0.00001)throw Error('INVALID_AMOUNT');return Math.round(n*100)/100;}
function opsFinance_(p){var d={};OPS_FIELDS_.forEach(function(k){d[k]=opsAmount_(p[k]);});d.finalized=p.finalized===true;d.note=String(p.note||'').trim().slice(0,1000);if(d.finalized&&OPS_FIELDS_.some(function(k){return d[k]===null;}))throw Error('INCOMPLETE_FINANCE');return d;}
function opsResult_(d){if(!d.finalized||OPS_FIELDS_.some(function(k){return d[k]===null||d[k]===undefined;}))return {profit:null,courierDue:null};return {profit:Math.round((d.customerPaid+d.courierCollected-d.refundPaid-d.goodsCost-d.packagingCost-d.courierCost-d.otherCost)*100)/100,courierDue:Math.round((d.courierCollected-d.courierCost-d.courierRemitted)*100)/100};}
function opsReturn_(p,old){var d={};['productId','originalSize','kind','stage','condition','replacementId','replacementSize','stockAction','note'].forEach(function(k){d[k]=String(p[k]||'').trim().slice(0,k==='note'?1000:160);});d.qty=Number(p.qty);if(!Number.isSafeInteger(d.qty)||d.qty<1||d.qty>500)throw Error('INVALID_RETURN_QTY');if(['return','exchange'].indexOf(d.kind)<0)throw Error('INVALID_RETURN_KIND');var transitions={new:['requested'],requested:['requested','approved','rejected'],approved:['approved','received','rejected'],received:['received','inspected'],inspected:['inspected','closed'],closed:['closed'],rejected:['rejected']};var prior=old?old.stage:'new';if(!transitions[prior]||transitions[prior].indexOf(d.stage)<0)throw Error('INVALID_TRANSITION');if(!d.productId||!d.originalSize||!d.note)throw Error('RETURN_EVIDENCE_REQUIRED');if(['unknown','resalable','damaged'].indexOf(d.condition)<0)throw Error('INVALID_CONDITION');if(['inspected','closed'].indexOf(d.stage)>=0&&d.condition==='unknown')throw Error('INSPECTION_REQUIRED');if(d.stage==='closed'&&!d.stockAction)throw Error('STOCK_ACTION_REQUIRED');if(d.kind==='exchange'&&['approved','received','inspected','closed'].indexOf(d.stage)>=0&&(!d.replacementId||!d.replacementSize))throw Error('REPLACEMENT_REQUIRED');d.refundAmount=opsAmount_(p.refundAmount);d.shippingCost=opsAmount_(p.shippingCost);return d;}
function opsLatest_(){var sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('OperationsRecords'),map={};if(!sh||sh.getLastRow()<2)return map;if(sh.getRange(1,1,1,7).getValues()[0].join('|')!==OPS_HEADERS_.join('|'))throw Error('OPS_HEADER_CONFLICT');var rows=sh.getRange(2,1,sh.getLastRow()-1,7).getValues();rows.forEach(function(r,index){if(!r[0])return;map[String(r[0])]={id:String(r[0]),kind:String(r[1]),orderId:String(r[2]),data:JSON.parse(String(r[3])),revision:Number(r[4]),updatedAt:formatCell_(r[5]),sequence:index,updatedBy:String(r[6])};});return map;}
function opsAppend_(r,who){var ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ss.getSheetByName('OperationsRecords');if(!sh){sh=ss.insertSheet('OperationsRecords');sh.getRange(1,1,1,7).setValues([OPS_HEADERS_]);sh.setFrozenRows(1);}if(sh.getRange(1,1,1,7).getValues()[0].join('|')!==OPS_HEADERS_.join('|'))throw Error('OPS_HEADER_CONFLICT');sh.appendRow([admCellText_(r.id,140),r.kind,admCellText_(r.orderId,100),JSON.stringify(r.data),r.revision,new Date(),admCellText_(who,100)]);}
function opsGetOrder_(id){var rows=admReadAll_(admGetSheet_()),found=null;for(var i=0;i<rows.length;i++)if(String(rows[i][8]||'').trim()===id){if(found)throw Error('DUPLICATE_ORDER_ID');found=admRowToOrder_(rows[i],i+2);}if(!found)throw Error('ORDER_NOT_FOUND');return found;}
function opsHandle_(type,e){var v=verifyAdminSession_(param_(e,'Token'));if(!v.ok)return v;var denied=requireOwnerAdmin_(v);if(denied)return denied;try{
 if(type==='AdminOperationsHealth')return opsHealth_();
 if(type==='AdminOperationsList'){var latest=opsLatest_(),orderStatuses={};admReadAll_(admGetSheet_()).forEach(function(row){var id=String(row[8]||'').trim();orderStatuses[id]=Object.prototype.hasOwnProperty.call(orderStatuses,id)?'DUPLICATE':String(row[9]||'');});return {ok:true,version:1,records:Object.keys(latest).map(function(k){var r=latest[k];if(r.kind==='finance'){r.needsReview=r.data.orderStatus!==orderStatuses[r.orderId]||Object.keys(latest).some(function(key){var ret=latest[key];return ret.kind==='return'&&ret.orderId===r.orderId&&ret.sequence>r.sequence;});r.result=r.needsReview?{profit:null,courierDue:null}:opsResult_(r.data);}return r;})};}
 if(type!=='AdminOperationsSave')return {ok:false,error:'UNKNOWN_TYPE'};
 var p=JSON.parse(param_(e,'Payload')||'{}'),kind=p.kind,orderId=String(p.orderId||'').trim();if(['finance','return'].indexOf(kind)<0)throw Error('INVALID_KIND');
 var lock=LockService.getScriptLock();lock.waitLock(20000);try{
  var order=opsGetOrder_(orderId),all=opsLatest_(),id=kind==='finance'?'finance:'+orderId:String(p.id||'').trim();
  if(kind==='return'&&!/^return:[A-Za-z0-9-]{8,80}$/.test(id))throw Error('INVALID_CASE_ID');
  var old=all[id];if(old&&(old.kind!==kind||old.orderId!==orderId))throw Error('RECORD_MISMATCH');if(Number(p.revision)!==(old?old.revision:0))throw Error('REVISION_CONFLICT');
  var d=kind==='finance'?opsFinance_(p.data||{}):opsReturn_(p.data||{},old&&old.data);
  if(kind==='finance'&&d.finalized&&!/^(delivered|returned|cancelled|canceled)$/i.test(order.status))throw Error('ORDER_NOT_FINAL');
  if(kind==='return'){var qty=0;Object.keys(all).forEach(function(k){var r=all[k];if(k!==id&&r.kind==='return'&&r.orderId===orderId&&r.data.stage!=='rejected')qty+=r.data.qty;});if(d.stage!=='rejected'&&qty+d.qty>order.qty)throw Error('RETURN_QTY_EXCEEDS_ORDER');if(d.kind==='exchange'&&d.replacementId){var product=opsCatalog_().products.filter(function(x){return x.id===d.replacementId;})[0];if(!product)throw Error('UNKNOWN_REPLACEMENT');}}
  if(kind==='finance')d.orderStatus=order.status;var record={id:id,kind:kind,orderId:orderId,data:d,revision:old?old.revision+1:1};opsAppend_(record,v.email||v.name||'owner');return {ok:true,record:record};
 }finally{lock.releaseLock();}
}catch(err){return {ok:false,error:String(err.message||err).slice(0,120),message:'যাচাই করুন: '+String(err.message||err).slice(0,120)};}}
function opsHealth_(){var ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ss.getSheetByName('StockVariants'),tracked=0,unknown=0;if(sh&&sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,7).getValues().forEach(function(r){if(!r[0])return;if(r[4]===true)tracked++;else unknown++;});var catalogCount=0;try{catalogCount=opsCatalog_().products.length;}catch(err){}return {ok:true,version:1,checkedAt:Utilities.formatDate(new Date(),'Asia/Dhaka','yyyy-MM-dd HH:mm:ss'),catalogOk:catalogCount>0,catalogCount:catalogCount,dailyBackup:hasDailySafetyBackupTrigger_(),lastBackup:opsDhakaTime_(PropertiesService.getScriptProperties().getProperty('OPS_LAST_BACKUP_AT')),courierSync:hasSteadfastStatusSyncTrigger_(),orderSync:typeof hasOrderSyncTrigger_==='function'&&hasOrderSyncTrigger_(),lastOrderSync:opsDhakaTime_(PropertiesService.getScriptProperties().getProperty('ORDERSYNC_LAST_SYNC_AT')),trackedVariants:tracked,unknownVariants:unknown,note:'ট্রিগার থাকা সফল execution-এর প্রমাণ নয়। শেষ backup সময় নতুন সংস্করণ থেকে রাখা হয়। স্টকের সংখ্যা বিদ্যমান StockVariants রেকর্ডের।'};}
function opsCatalog_(){
 var cache=CacheService.getScriptCache(),c=cache.get('ops_catalog_v2');if(c)return JSON.parse(c);
 var res=UrlFetchApp.fetch('https://muslimabaya.com/catalog-validation.json',{muteHttpExceptions:true});
 if(res.getResponseCode()!==200)throw Error('CATALOG_UNAVAILABLE');var data=JSON.parse(res.getContentText());
 var files=['product-config.js','product-utils.js','category-products.js','product-links-data.js','product-catalog-sync.js'];
 if(data.version!==1||!Array.isArray(data.products)||!data.products.length||JSON.stringify(data.sources)!==JSON.stringify(files))throw Error('CATALOG_INVALID');
 var responses=UrlFetchApp.fetchAll(files.map(function(file){return {url:'https://muslimabaya.com/'+file+'?catalog_check='+Date.now(),muteHttpExceptions:true,headers:{'Cache-Control':'no-cache'}};}));
 var text='';responses.forEach(function(r,i){if(r.getResponseCode()!==200)throw Error('CATALOG_UNAVAILABLE');text+=files[i]+'\u0000'+r.getContentText()+'\u0000';});
 var hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2);}).join('');
 if(hash!==data.sourceSha256)throw Error('CATALOG_OUTDATED');cache.put('ops_catalog_v2',JSON.stringify(data),60);return data;
